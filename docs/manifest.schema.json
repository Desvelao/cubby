{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cubby manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "description": "Manifest schema version; must be 1 (not the design revision; see project.revision)."
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F￾￿]*$",
          "description": "Design title (box.name is the physical box)."
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "^[^\\u0000-\\u0008\\u000B-\\u001F\\u007F-\\u009F￾￿]*$",
          "description": "Free-text summary; newlines and tabs allowed."
        },
        "revision": {
          "type": [
            "string",
            "number"
          ],
          "maxLength": 200,
          "description": "Design revision, e.g. \"1.2.0\". Unrelated to the schema version. Must not be blank.",
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F￾￿]*\\S[^\\u0000-\\u001F\\u007F-\\u009F￾￿]*$"
        },
        "author": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F￾￿]*$",
          "description": "Who designed the insert."
        },
        "contact": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F￾￿]*$",
          "description": "Email, handle or URL; a value that looks like an email address (bare or 'Name <addr>', not starting with '@', no '://') must be a valid one."
        },
        "license": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F￾￿]*$",
          "description": "License name, ideally an SPDX identifier such as CC-BY-4.0."
        },
        "url": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^https?://[^\\s/][^\\u0000-\\u001F\\u007F-\\u009F￾￿\\s]*$",
          "description": "Home page; must be an http or https URL with a host."
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 50,
            "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F￾￿]*\\S[^\\u0000-\\u001F\\u007F-\\u009F￾￿]*$",
            "description": "Short keyword (not blank)."
          },
          "description": "Up to 20 keywords."
        },
        "created": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Creation date, YYYY-MM-DD."
        },
        "updated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Last-modified date, YYYY-MM-DD; not before created."
        },
        "notes": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u0008\\u000B-\\u001F\\u007F-\\u009F￾￿]*$",
          "description": "Build or usage notes; newlines and tabs allowed."
        },
        "game": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F￾￿]*$",
          "description": "The game the insert is designed for."
        },
        "publisher": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F￾￿]*$",
          "description": "The game's publisher."
        },
        "edition": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F￾￿]*$",
          "description": "Game edition or box variant."
        }
      },
      "description": "Optional descriptive metadata about the design. Every field is optional."
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the physical box."
        },
        "units": {
          "type": "string",
          "enum": [
            "mm",
            "cm",
            "in"
          ],
          "default": "mm",
          "description": "Unit for every length in the manifest."
        },
        "interior": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Interior width in box.units."
            },
            "depth": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Interior depth in box.units."
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Interior height in box.units."
            }
          },
          "required": [
            "width",
            "depth",
            "height"
          ],
          "description": "Usable inside size of the box."
        }
      },
      "required": [
        "name",
        "interior"
      ],
      "description": "The container the insert must fit inside."
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Optional label for the material."
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Panel thickness in box.units."
        },
        "kerf": {
          "type": "number",
          "minimum": 0,
          "description": "Extra slot clearance in box.units.",
          "default": 0
        }
      },
      "required": [
        "thickness"
      ],
      "description": "What the divider panels are cut from."
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "padding": {
          "type": "number",
          "minimum": 0,
          "description": "Clearance around each component's footprint (box.units).",
          "default": 0
        },
        "margin": {
          "type": "number",
          "minimum": 0,
          "description": "Clearance around a compartment vs the box wall / other compartments (box.units).",
          "default": 0
        },
        "fullWalls": {
          "type": "boolean",
          "description": "Generate a panel on every side of a compartment, including edges against the box wall.",
          "default": false
        },
        "jointType": {
          "type": "string",
          "enum": [
            "notch",
            "plain"
          ],
          "description": "How crossing panels meet: interlocking notches or plain butt joints.",
          "default": "notch"
        },
        "dividers": {
          "type": "boolean",
          "description": "Divider panels between shelf rows / side-by-side items. Defaults ON.",
          "default": true
        },
        "expand": {
          "type": "boolean",
          "description": "Stretch trays along their row to the box edge.",
          "default": false
        },
        "removable": {
          "type": "boolean",
          "description": "Make each tray a self-contained open box.",
          "default": false
        },
        "floor": {
          "type": "boolean",
          "description": "Add a floor plate under each tray.",
          "default": false
        },
        "fillRemaining": {
          "type": "boolean",
          "description": "Grow the spatially-last compartment to the box's true edges.",
          "default": false
        },
        "externalHeightReduction": {
          "description": "Lower external panels (full-walls boundary walls, removable tray walls): box.units, \"N%\" or {by, panels}.",
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^\\s*\\d+(\\.\\d+)?\\s*%$"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "by"
              ],
              "properties": {
                "by": {
                  "oneOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^\\s*\\d+(\\.\\d+)?\\s*%$"
                    }
                  ]
                },
                "panels": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Only panels whose id matches (`*` globs); omit for all panels of the class."
                }
              }
            }
          ]
        },
        "dividerHeightReduction": {
          "description": "Lower divider panels (grid and internal): box.units, \"N%\" or {by, panels}.",
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^\\s*\\d+(\\.\\d+)?\\s*%$"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "by"
              ],
              "properties": {
                "by": {
                  "oneOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^\\s*\\d+(\\.\\d+)?\\s*%$"
                    }
                  ]
                },
                "panels": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Only panels whose id matches (`*` globs); omit for all panels of the class."
                }
              }
            }
          ]
        }
      },
      "description": "Fallback values for groups and ungrouped components."
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique component id."
          },
          "name": {
            "type": "string",
            "description": "Display name."
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Width in box.units."
          },
          "depth": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Depth in box.units."
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Height in box.units."
          },
          "qty": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "How many identical pieces."
          },
          "allowRotate": {
            "type": "boolean",
            "description": "Whether packing may rotate the piece 90 degrees. Omitted means true.",
            "default": true
          }
        },
        "required": [
          "id",
          "width",
          "depth",
          "height",
          "qty"
        ],
        "description": "One kind of physical piece to store."
      },
      "description": "The kinds of pieces to store."
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "^auto-[1-9][0-9]*$"
            },
            "description": "Unique group id; must not look like the generated auto-N ids."
          },
          "name": {
            "type": "string",
            "description": "Display name."
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "Component ids; each component may belong to at most one group."
          },
          "padding": {
            "type": "number",
            "minimum": 0,
            "description": "Overrides defaults.padding."
          },
          "margin": {
            "type": "number",
            "minimum": 0,
            "description": "Overrides defaults.margin."
          },
          "fullWalls": {
            "type": "boolean",
            "description": "Overrides defaults.fullWalls."
          },
          "jointType": {
            "type": "string",
            "enum": [
              "notch",
              "plain"
            ],
            "description": "Overrides defaults.jointType."
          },
          "dividers": {
            "type": "boolean",
            "description": "Overrides defaults.dividers."
          },
          "expand": {
            "type": "boolean",
            "description": "Overrides defaults.expand."
          },
          "removable": {
            "type": "boolean",
            "description": "Overrides defaults.removable; cannot be mixed with non-removable groups."
          },
          "floor": {
            "type": "boolean",
            "description": "Overrides defaults.floor."
          },
          "externalHeightReduction": {
            "description": "Overrides defaults.externalHeightReduction.",
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^\\s*\\d+(\\.\\d+)?\\s*%$"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "by"
                ],
                "properties": {
                  "by": {
                    "oneOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "string",
                        "pattern": "^\\s*\\d+(\\.\\d+)?\\s*%$"
                      }
                    ]
                  },
                  "panels": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "Only panels whose id matches (`*` globs); omit for all panels of the class."
                  }
                }
              }
            ]
          },
          "dividerHeightReduction": {
            "description": "Overrides defaults.dividerHeightReduction.",
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^\\s*\\d+(\\.\\d+)?\\s*%$"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "by"
                ],
                "properties": {
                  "by": {
                    "oneOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "string",
                        "pattern": "^\\s*\\d+(\\.\\d+)?\\s*%$"
                      }
                    ]
                  },
                  "panels": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "Only panels whose id matches (`*` globs); omit for all panels of the class."
                  }
                }
              }
            ]
          }
        },
        "required": [
          "id",
          "components"
        ],
        "description": "An explicit named compartment."
      },
      "description": "Explicit compartments."
    }
  },
  "required": [
    "version",
    "box",
    "material"
  ],
  "description": "A cubby box manifest. Rules needing cross-checks (unique ids, references, feasibility) are only enforced by `cubby validate`."
}
